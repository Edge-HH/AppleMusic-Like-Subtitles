            Duration = { LINKS_Name = "Auto duration / 自动唱完秒数", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 4, INP_MinScale = 0.01, INP_MaxScale = 120, INP_MinAllowed = 0.01, INP_MaxAllowed = 120, INP_Integer = false, },
            Offset = { LINKS_Name = "Offset / 整体延后秒数", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 0.3, INP_MinScale = -120, INP_MaxScale = 120, INP_MinAllowed = -120, INP_MaxAllowed = 120, INP_Integer = false, },
            Softness = { LINKS_Name = "Transition / 每字过渡比例", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 0.85, INP_MinScale = 0.01, INP_MaxScale = 1, INP_MinAllowed = 0.01, INP_MaxAllowed = 1, INP_Integer = false, },
