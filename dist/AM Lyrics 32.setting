            IdleOpacity = { LINKS_Name = "Idle opacity / 未唱透明度", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 0.35, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            ActiveOpacity = { LINKS_Name = "Active opacity / 已唱透明度", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            IdleBrightness = { LINKS_Name = "Idle brightness / 未唱亮度", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 0.85, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            IdleBlur = { LINKS_Name = "Idle blur / 未唱模糊", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 1.5, INP_MinScale = 0, INP_MaxScale = 30, INP_MinAllowed = 0, INP_MaxAllowed = 30, INP_Integer = false, },
            ActiveBlur = { LINKS_Name = "Active blur / 已唱模糊", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 30, INP_MinAllowed = 0, INP_MaxAllowed = 30, INP_Integer = false, },
            OverallOpacity = { LINKS_Name = "Overall opacity / 总透明度", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            Status = { LINKS_Name = "Status / 输入检查", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", ICS_ControlPage = "Controls", INP_External = true, TEC_Lines = 1, TEC_Wrap = true, TEC_ReadOnly = true, },
            Count = { LINKS_Name = "Internal character count", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls", INP_External = true, INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 100000, INP_MinAllowed = 0, INP_MaxAllowed = 100000, INP_Integer = false, },
