{
  Tools = ordered() {
    AMLLyrics = MacroOperator {
      Inputs = ordered() {
        Lyrics = InstanceInput { SourceOp = "Controller", Source = "Lyrics", Name = "Lyrics / 用 | 分段", Page = "Lyrics", },
        Timings = InstanceInput { SourceOp = "Controller", Source = "Timings", Name = "Timings / 起止秒数（可留空）", Page = "Lyrics", },
        Duration = InstanceInput { SourceOp = "Controller", Source = "Duration", Name = "Auto duration / 自动唱完秒数", Page = "Lyrics", },
        Offset = InstanceInput { SourceOp = "Controller", Source = "Offset", Name = "Offset / 整体延后秒数", Page = "Lyrics", },
        Softness = InstanceInput { SourceOp = "Controller", Source = "Softness", Name = "Transition / 每字过渡比例", Page = "Lyrics", },
        FPS = InstanceInput { SourceOp = "Controller", Source = "FPS", Name = "FPS / 0 为合成帧率", Page = "Lyrics", },
        IdleOpacity = InstanceInput { SourceOp = "Controller", Source = "IdleOpacity", Name = "Idle opacity / 未唱透明度", Page = "Lyrics", },
        ActiveOpacity = InstanceInput { SourceOp = "Controller", Source = "ActiveOpacity", Name = "Active opacity / 已唱透明度", Page = "Lyrics", },
        IdleBrightness = InstanceInput { SourceOp = "Controller", Source = "IdleBrightness", Name = "Idle brightness / 未唱亮度", Page = "Lyrics", },
        IdleBlur = InstanceInput { SourceOp = "Controller", Source = "IdleBlur", Name = "Idle blur / 未唱模糊", Page = "Lyrics", },
        ActiveBlur = InstanceInput { SourceOp = "Controller", Source = "ActiveBlur", Name = "Active blur / 已唱模糊", Page = "Lyrics", },
        OverallOpacity = InstanceInput { SourceOp = "Controller", Source = "OverallOpacity", Name = "Overall opacity / 总透明度", Page = "Lyrics", },
        Status = InstanceInput { SourceOp = "Controller", Source = "Status", Page = "Lyrics", },
        Font = InstanceInput { SourceOp = "Controller", Source = "Font", Name = "Font / 字体", Page = "Style", ControlGroup = 1, },
        Style = InstanceInput { SourceOp = "Controller", Source = "Style", Name = "Weight / 字重", Page = "Style", ControlGroup = 1, },
        Size = InstanceInput { SourceOp = "Controller", Source = "Size", Name = "Size / 字号", Page = "Style", },
        Center = InstanceInput { SourceOp = "Controller", Source = "Center", Name = "Position / 位置", Page = "Style", },
        CharacterSpacing = InstanceInput { SourceOp = "Controller", Source = "CharacterSpacing", Name = "Tracking / 字距", Page = "Style", },
        LineSpacing = InstanceInput { SourceOp = "Controller", Source = "LineSpacing", Name = "Line spacing / 行距", Page = "Style", },
        Red1 = InstanceInput { SourceOp = "Controller", Source = "Red1", Name = "Color / 颜色", Page = "Style", ControlGroup = 2, },
        Green1 = InstanceInput { SourceOp = "Controller", Source = "Green1", Name = "Color / 颜色", Page = "Style", ControlGroup = 2, },
        Blue1 = InstanceInput { SourceOp = "Controller", Source = "Blue1", Name = "Color / 颜色", Page = "Style", ControlGroup = 2, }
      },
      Outputs = { MainOutput1 = InstanceOutput { SourceOp = "Merge32", Source = "Output", } },
      ViewInfo = GroupInfo { Pos = { 0, 0 } },
      Tools = ordered() {
        Controller = TextPlus {
          Inputs = {
            Lyrics = Input { Value = "我|想要|留住|这一刻", },
            Timings = Input { Value = "", },
            Duration = Input { Value = 4, },
            Offset = Input { Value = 0.3, },
            Softness = Input { Value = 0.85, },
            FPS = Input { Value = 0, },
            IdleOpacity = Input { Value = 0.35, },
            ActiveOpacity = Input { Value = 1, },
            IdleBrightness = Input { Value = 0.85, },
            IdleBlur = Input { Value = 1.5, },
            ActiveBlur = Input { Value = 0, },
            OverallOpacity = Input { Value = 1, },
            Status = Input { Expression = ":local CAPACITY = 32\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    -- UTF-8 code points, not bytes. Complex grapheme clusters are not supported.\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do\n        result[#result + 1] = character\n    end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges = {}\nlocal errorMessage = nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(Controller.Duration, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then\n        errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > CAPACITY then errorMessage = \"Over \" .. CAPACITY .. \" characters: split clip or use 64-char preset\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \"/\" .. CAPACITY .. \" characters\")\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            local p = math.max(0, math.min(1, (now - start) / duration))\n            -- Smoothstep has zero velocity at both ends; no spring overshoot.\n            return p * p * (3 - 2 * p)\n        end\n    end\n    return -1\nend\n\nreturn status", },
            Count = Input { Expression = ":local CAPACITY = 32\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    -- UTF-8 code points, not bytes. Complex grapheme clusters are not supported.\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do\n        result[#result + 1] = character\n    end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges = {}\nlocal errorMessage = nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(Controller.Duration, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then\n        errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > CAPACITY then errorMessage = \"Over \" .. CAPACITY .. \" characters: split clip or use 64-char preset\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \"/\" .. CAPACITY .. \" characters\")\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            local p = math.max(0, math.min(1, (now - start) / duration))\n            -- Smoothstep has zero velocity at both ends; no spring overshoot.\n            return p * p * (3 - 2 * p)\n        end\n    end\n    return -1\nend\n\nreturn count", },
            StyledText = Input { Expression = ":local CAPACITY = 32\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    -- UTF-8 code points, not bytes. Complex grapheme clusters are not supported.\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do\n        result[#result + 1] = character\n    end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges = {}\nlocal errorMessage = nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(Controller.Duration, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then\n        errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > CAPACITY then errorMessage = \"Over \" .. CAPACITY .. \" characters: split clip or use 64-char preset\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \"/\" .. CAPACITY .. \" characters\")\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            local p = math.max(0, math.min(1, (now - start) / duration))\n            -- Smoothstep has zero velocity at both ends; no spring overshoot.\n            return p * p * (3 - 2 * p)\n        end\n    end\n    return -1\nend\n\nreturn clean", },
            Font = Input { Value = "Microsoft YaHei", },
            Style = Input { Value = "Bold", },
            Size = Input { Value = 0.065, },
            Center = Input { Value = { 0.5, 0.5 }, },
            UseFrameFormatSettings = Input { Value = 1, },
            Width = Input { Value = 1920, },
            Height = Input { Value = 1080, },
