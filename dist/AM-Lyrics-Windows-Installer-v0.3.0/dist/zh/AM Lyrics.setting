{
  Tools = ordered() {
    AMLLyrics = MacroOperator {
      Inputs = ordered() {
        Lyrics = InstanceInput { SourceOp = "Controller", Source = "Lyrics", Name = "歌词（用 | 分段）", Page = "Controls", },
        Timings = InstanceInput { SourceOp = "Controller", Source = "Timings", Name = "逐字时间（开始-结束秒）", Page = "Controls", },
        Duration = InstanceInput { SourceOp = "Controller", Source = "Duration", Name = "自动唱完秒数", Page = "Controls", },
        Offset = InstanceInput { SourceOp = "Controller", Source = "Offset", Name = "整体延后秒数", Page = "Controls", },
        Softness = InstanceInput { SourceOp = "Controller", Source = "Softness", Name = "高亮过渡柔和度", Page = "Controls", },
        FPS = InstanceInput { SourceOp = "Controller", Source = "FPS", Name = "帧率（0 为合成帧率）", Page = "Controls", },
        FadeWidth = InstanceInput { SourceOp = "Controller", Source = "FadeWidth", Name = "单字内渐变宽度", Page = "Controls", },
        BounceAmount = InstanceInput { SourceOp = "Controller", Source = "BounceAmount", Name = "轻微跳动强度", Page = "Controls", },
        BounceHeight = InstanceInput { SourceOp = "Controller", Source = "BounceHeight", Name = "上浮幅度", Page = "Controls", },
        ResetMotion = InstanceInput { SourceOp = "Controller", Source = "ResetMotion", Name = "重置动画参数", Page = "Controls", },
        Status = InstanceInput { SourceOp = "Controller", Source = "Status", Page = "Controls", },
        Font = InstanceInput { SourceOp = "Controller", Source = "Font", Name = "字体", Page = "Style", ControlGroup = 1, },
        Style = InstanceInput { SourceOp = "Controller", Source = "Style", Name = "字重", Page = "Style", ControlGroup = 1, },
        Size = InstanceInput { SourceOp = "Controller", Source = "Size", Name = "字号", Page = "Style", },
        Center = InstanceInput { SourceOp = "Controller", Source = "Center", Name = "位置", Page = "Style", },
        CharacterSpacing = InstanceInput { SourceOp = "Controller", Source = "CharacterSpacing", Name = "字距", Page = "Style", },
        LineSpacing = InstanceInput { SourceOp = "Controller", Source = "LineSpacing", Name = "行距", Page = "Style", },
        Red1 = InstanceInput { SourceOp = "Controller", Source = "Red1", Name = "高亮颜色", Page = "Style", ControlGroup = 2, },
        Green1 = InstanceInput { SourceOp = "Controller", Source = "Green1", Name = "高亮颜色", Page = "Style", ControlGroup = 2, },
        Blue1 = InstanceInput { SourceOp = "Controller", Source = "Blue1", Name = "高亮颜色", Page = "Style", ControlGroup = 2, },
        IdleOpacity = InstanceInput { SourceOp = "Controller", Source = "IdleOpacity", Name = "未唱透明度", Page = "Style", },
        ActiveOpacity = InstanceInput { SourceOp = "Controller", Source = "ActiveOpacity", Name = "已唱透明度", Page = "Style", },
        IdleBrightness = InstanceInput { SourceOp = "Controller", Source = "IdleBrightness", Name = "未唱亮度", Page = "Style", },
        IdleBlur = InstanceInput { SourceOp = "Controller", Source = "IdleBlur", Name = "未唱模糊", Page = "Style", },
        ActiveBlur = InstanceInput { SourceOp = "Controller", Source = "ActiveBlur", Name = "已唱模糊", Page = "Style", },
        GlowGain = InstanceInput { SourceOp = "Controller", Source = "GlowGain", Name = "高亮炫光强度", Page = "Style", },
        GlowSize = InstanceInput { SourceOp = "Controller", Source = "GlowSize", Name = "高亮炫光大小", Page = "Style", },
        OverallOpacity = InstanceInput { SourceOp = "Controller", Source = "OverallOpacity", Name = "总透明度", Page = "Style", },
        ResetLook = InstanceInput { SourceOp = "Controller", Source = "ResetLook", Name = "重置样式参数", Page = "Style", }
      },
      Outputs = { MainOutput1 = InstanceOutput { SourceOp = "FinalMerge", Source = "Output", } },
      ViewInfo = GroupInfo { Pos = { 0, 0 } },
      Tools = ordered() {
        Controller = TextPlus {
          Inputs = {
            Lyrics = Input { Value = "我|想要|留住|这一刻", },
            Timings = Input { Value = "", },
            Duration = Input { Value = 4, },
            Offset = Input { Value = 0, },
            Softness = Input { Value = 0.72, },
            FPS = Input { Value = 0, },
            FadeWidth = Input { Value = 0.035, },
            BounceAmount = Input { Value = 0.035, },
            BounceHeight = Input { Value = 0.012, },
            IdleOpacity = Input { Value = 0.28, },
            ActiveOpacity = Input { Value = 1, },
            IdleBrightness = Input { Value = 0.52, },
            IdleBlur = Input { Value = 0.75, },
            ActiveBlur = Input { Value = 0, },
            GlowGain = Input { Value = 1.35, },
            GlowSize = Input { Value = 4.5, },
            OverallOpacity = Input { Value = 1, },
            Status = Input { Expression = ":local MAX_CHARACTERS = 256\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do result[#result + 1] = character end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal function clamp(value, low, high) return math.max(low, math.min(high, value)) end\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges, errorMessage = {}, nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(tonumber(Controller.Duration) or 4, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > MAX_CHARACTERS then errorMessage = \"Over \" .. MAX_CHARACTERS .. \" characters: split the lyric line\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \" characters\")\nlocal function smooth(value)\n    local p = clamp(value, 0, 1)\n    return p * p * (3 - 2 * p)\nend\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            return smooth((now - start) / duration)\n        end\n    end\n    return -1\nend\nlocal sweep = valid and 0 or 1\nlocal pulse = 0\nif valid then\n    local completed = 0\n    for _, range in ipairs(ranges) do\n        local localProgress = smooth((now - range.start) / math.max(range.finish - range.start, 0.000001))\n        if now >= range.finish then completed = completed + range.length\n        elseif now >= range.start then\n            sweep = (completed + range.length * localProgress) / math.max(count, 1)\n            local pulseDuration = math.min(math.max(range.finish - range.start, 0.2), 0.65)\n            local pulseTime = clamp((now - range.start) / pulseDuration, 0, 1)\n            pulse = math.sin(pulseTime * math.pi) * (1 - pulseTime * 0.35)\n            break\n        else\n            sweep = completed / math.max(count, 1)\n            break\n        end\n        sweep = completed / math.max(count, 1)\n    end\nend\nsweep = clamp(sweep, 0, 1)\nlocal spacing = math.max(0.2, tonumber(Controller.CharacterSpacing) or 1)\nlocal textWidth = clamp(count * (tonumber(Controller.Size) or 0.075) * 0.55 * spacing, 0.03, 0.92)\nlocal fadeWidth = clamp(tonumber(Controller.FadeWidth) or 0.035, 0.001, 0.25)\nlocal maskWidth = clamp(textWidth * sweep + fadeWidth, fadeWidth, 1)\nlocal centerX = tonumber(Controller.Center.X) or 0.5\nlocal maskCenterX = centerX - textWidth / 2 - fadeWidth + maskWidth / 2\nlocal maskSoft = clamp(fadeWidth / math.max(maskWidth, 0.001), 0.001, 0.5)\n\nreturn status", },
            Count = Input { Expression = ":local MAX_CHARACTERS = 256\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do result[#result + 1] = character end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal function clamp(value, low, high) return math.max(low, math.min(high, value)) end\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges, errorMessage = {}, nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(tonumber(Controller.Duration) or 4, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > MAX_CHARACTERS then errorMessage = \"Over \" .. MAX_CHARACTERS .. \" characters: split the lyric line\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \" characters\")\nlocal function smooth(value)\n    local p = clamp(value, 0, 1)\n    return p * p * (3 - 2 * p)\nend\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            return smooth((now - start) / duration)\n        end\n    end\n    return -1\nend\nlocal sweep = valid and 0 or 1\nlocal pulse = 0\nif valid then\n    local completed = 0\n    for _, range in ipairs(ranges) do\n        local localProgress = smooth((now - range.start) / math.max(range.finish - range.start, 0.000001))\n        if now >= range.finish then completed = completed + range.length\n        elseif now >= range.start then\n            sweep = (completed + range.length * localProgress) / math.max(count, 1)\n            local pulseDuration = math.min(math.max(range.finish - range.start, 0.2), 0.65)\n            local pulseTime = clamp((now - range.start) / pulseDuration, 0, 1)\n            pulse = math.sin(pulseTime * math.pi) * (1 - pulseTime * 0.35)\n            break\n        else\n            sweep = completed / math.max(count, 1)\n            break\n        end\n        sweep = completed / math.max(count, 1)\n    end\nend\nsweep = clamp(sweep, 0, 1)\nlocal spacing = math.max(0.2, tonumber(Controller.CharacterSpacing) or 1)\nlocal textWidth = clamp(count * (tonumber(Controller.Size) or 0.075) * 0.55 * spacing, 0.03, 0.92)\nlocal fadeWidth = clamp(tonumber(Controller.FadeWidth) or 0.035, 0.001, 0.25)\nlocal maskWidth = clamp(textWidth * sweep + fadeWidth, fadeWidth, 1)\nlocal centerX = tonumber(Controller.Center.X) or 0.5\nlocal maskCenterX = centerX - textWidth / 2 - fadeWidth + maskWidth / 2\nlocal maskSoft = clamp(fadeWidth / math.max(maskWidth, 0.001), 0.001, 0.5)\n\nreturn count", },
            Sweep = Input { Expression = ":local MAX_CHARACTERS = 256\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do result[#result + 1] = character end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal function clamp(value, low, high) return math.max(low, math.min(high, value)) end\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges, errorMessage = {}, nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(tonumber(Controller.Duration) or 4, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > MAX_CHARACTERS then errorMessage = \"Over \" .. MAX_CHARACTERS .. \" characters: split the lyric line\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \" characters\")\nlocal function smooth(value)\n    local p = clamp(value, 0, 1)\n    return p * p * (3 - 2 * p)\nend\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            return smooth((now - start) / duration)\n        end\n    end\n    return -1\nend\nlocal sweep = valid and 0 or 1\nlocal pulse = 0\nif valid then\n    local completed = 0\n    for _, range in ipairs(ranges) do\n        local localProgress = smooth((now - range.start) / math.max(range.finish - range.start, 0.000001))\n        if now >= range.finish then completed = completed + range.length\n        elseif now >= range.start then\n            sweep = (completed + range.length * localProgress) / math.max(count, 1)\n            local pulseDuration = math.min(math.max(range.finish - range.start, 0.2), 0.65)\n            local pulseTime = clamp((now - range.start) / pulseDuration, 0, 1)\n            pulse = math.sin(pulseTime * math.pi) * (1 - pulseTime * 0.35)\n            break\n        else\n            sweep = completed / math.max(count, 1)\n            break\n        end\n        sweep = completed / math.max(count, 1)\n    end\nend\nsweep = clamp(sweep, 0, 1)\nlocal spacing = math.max(0.2, tonumber(Controller.CharacterSpacing) or 1)\nlocal textWidth = clamp(count * (tonumber(Controller.Size) or 0.075) * 0.55 * spacing, 0.03, 0.92)\nlocal fadeWidth = clamp(tonumber(Controller.FadeWidth) or 0.035, 0.001, 0.25)\nlocal maskWidth = clamp(textWidth * sweep + fadeWidth, fadeWidth, 1)\nlocal centerX = tonumber(Controller.Center.X) or 0.5\nlocal maskCenterX = centerX - textWidth / 2 - fadeWidth + maskWidth / 2\nlocal maskSoft = clamp(fadeWidth / math.max(maskWidth, 0.001), 0.001, 0.5)\n\nreturn sweep", },
            Pulse = Input { Expression = ":local MAX_CHARACTERS = 256\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function characters(value)\n    local result = {}\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do result[#result + 1] = character end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal function clamp(value, low, high) return math.max(low, math.min(high, value)) end\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges, errorMessage = {}, nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(tonumber(Controller.Duration) or 4, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > MAX_CHARACTERS then errorMessage = \"Over \" .. MAX_CHARACTERS .. \" characters: split the lyric line\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \" characters\")\nlocal function smooth(value)\n    local p = clamp(value, 0, 1)\n    return p * p * (3 - 2 * p)\nend\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            return smooth((now - start) / duration)\n        end\n    end\n    return -1\nend\nlocal sweep = valid and 0 or 1\nlocal pulse = 0\nif valid then\n    local completed = 0\n    for _, range in ipairs(ranges) do\n        local localProgress = smooth((now - range.start) / math.max(range.finish - range.start, 0.000001))\n        if now >= range.finish then completed = completed + range.length\n        elseif now >= range.start then\n            sweep = (completed + range.length * localProgress) / math.max(count, 1)\n            local pulseDuration = math.min(math.max(range.finish - range.start, 0.2), 0.65)\n            local pulseTime = clamp((now - range.start) / pulseDuration, 0, 1)\n            pulse = math.sin(pulseTime * math.pi) * (1 - pulseTime * 0.35)\n            break\n        else\n            sweep = completed / math.max(count, 1)\n            break\n        end\n        sweep = completed / math.max(count, 1)\n    end\nend\nsweep = clamp(sweep, 0, 1)\nlocal spacing = math.max(0.2, tonumber(Controller.CharacterSpacing) or 1)\nlocal textWidth = clamp(count * (tonumber(Controller.Size) or 0.075) * 0.55 * spacing, 0.03, 0.92)\nlocal fadeWidth = clamp(tonumber(Controller.FadeWidth) or 0.035, 0.001, 0.25)\nlocal maskWidth = clamp(textWidth * sweep + fadeWidth, fadeWidth, 1)\nlocal centerX = tonumber(Controller.Center.X) or 0.5\nlocal maskCenterX = centerX - textWidth / 2 - fadeWidth + maskWidth / 2\nlocal maskSoft = clamp(fadeWidth / math.max(maskWidth, 0.001), 0.001, 0.5)\n\nreturn pulse", },
