h.max(0.01, Controller.Softness), 0.000001)\n            return smooth((now - start) / duration)\n        end\n    end\n    return -1\nend\nlocal sweep = valid and 0 or 1\nlocal currentIndex = 0\nif valid then\n    local completed = 0\n    for _, range in ipairs(ranges) do\n        local rangeDuration = math.max(range.finish - range.start, 0.000001)\n        local localProgress = smooth((now - range.start) / rangeDuration)\n        if now >= range.finish then\n            completed = completed + range.length\n        elseif now >= range.start then\n            sweep = (completed + range.length * localProgress) / math.max(count, 1)\n            local step = rangeDuration / math.max(range.length, 1)\n            local offset = math.floor(math.max(0, now - range.start) / math.max(step, 0.000001))\n            offset = math.min(math.max(offset, 0), math.max(range.length - 1, 0))\n            currentIndex = range.first + offset\n            break\n        else\n            sweep = completed / math.max(count, 1)\n            break\n        end\n        sweep = completed / math.max(count, 1)\n    end\nend\nsweep = clamp(sweep, 0, 1)\nlocal spacing = math.max(0.2, tonumber(Controller.CharacterSpacing) or 1)\nlocal textWidth = clamp(count * (tonumber(Controller.Size) or 0.075) * 0.55 * spacing, 0.03, 0.92)\nlocal fadeWidth = clamp(tonumber(Controller.FadeWidth) or 0.035, 0.001, 0.25)\nlocal maskWidth = clamp(textWidth * sweep + fadeWidth, fadeWidth, textWidth + fadeWidth)\nlocal centerX = tonumber(Controller.Center.X) or 0.5\nlocal maskCenterX = centerX - textWidth / 2 + maskWidth / 2\n-- Keep the leading edge visible but make the active/inactive boundary readable.\nlocal maskSoft = clamp(fadeWidth / math.max(maskWidth, 0.001), 0.002, 0.18)\nlocal currentMaskWidth = 0\nlocal currentMaskCenterX = centerX\nlocal currentMaskSoft = 0.01\nif currentIndex > 0 and currentIndex <= count then\n    local characterWidth = textWidth / math.max(count, 1)\n    currentMaskWidth = clamp(characterWidth + fadeWidth * 0.5, fadeWidth, 1)\n    currentMaskCenterX = centerX - textWidth / 2 + characterWidth * (currentIndex - 0.5)\n    currentMaskSoft = clamp((fadeWidth / math.max(characterWidth, 0.001)) * 0.08, 0.01, 0.08)\nend\nlocal currentOpacity = (currentIndex > 0 and currentIndex <= count) and 1 or 0\n\nreturn currentMaskCenterX", },
