            StartPosition = { LINKS_Name = "Start position", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "ButtonControl", BTNCS_Execute = "local value = tonumber(tool:GetInput(\"SegmentCharacters\")) or 0\nvalue = math.max(0, math.floor(value + 0.5))\ntool:SetInput(\"SegmentStart\", value)", },
            EndPosition = { LINKS_Name = "End position", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "ButtonControl", BTNCS_Execute = "local value = tonumber(tool:GetInput(\"SegmentCharacters\")) or 0\nvalue = math.max(0, math.floor(value + 0.5))\ntool:SetInput(\"SegmentEnd\", value)", },
            SetSegment = { LINKS_Name = "Set segment", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "ButtonControl", BTNCS_Execute = "local function read(name)\n  local value = tool:GetInput(name)\n  if type(value) == \"table\" then return value.Value or \"\" end\n  return value or \"\"\nend\nlocal function parse(value)\n  local result, positions = {}, {}\n  local count = 0\n  for character in tostring(value):gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do\n    if character == \"|\" then\n      if count > 0 then positions[count] = true end\n    else\n      result[#result + 1] = character\n      count = count + 1\n    end\n  end\n  return result, positions\nend\nlocal lyricChars, positions = parse(read(\"Lyrics\"))\nlocal total = #lyricChars\nlocal start = math.min(total, math.max(0, math.floor(tonumber(read(\"SegmentStart\")) or 0)))\nlocal finish = math.min(total, math.max(0, math.floor(tonumber(read(\"SegmentEnd\")) or 0)))\nif start > 0 and start < total then positions[start] = true end\nif finish > 0 and finish < total then positions[finish] = true end\nif next(positions) == nil then return end\nlocal output = {}\nfor index, character in ipairs(lyricChars) do\n  if index > 1 and positions[index - 1] then output[#output + 1] = \"|\" end\n  output[#output + 1] = character\nend\ntool:SetInput(\"Lyrics\", table.concat(output))\ntool:SetInput(\"Timings\", \"\")", },
            SegmentStatus = { LINKS_Name = "Segment marker status", LINKID_DataType = "Text", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "TextEditControl", TEC_Lines = 1, TEC_Wrap = true, TEC_ReadOnly = true, },
            Status = { LINKS_Name = "Input status", LINKID_DataType = "Text", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "TextEditControl", TEC_Lines = 1, TEC_Wrap = true, TEC_ReadOnly = true, },
            Count = { LINKS_Name = "Internal character count", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 100000, INP_MinAllowed = 0, INP_MaxAllowed = 100000, INP_Integer = false, },
            Sweep = { LINKS_Name = "Internal sweep", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            CurrentIndex = { LINKS_Name = "Internal current character index", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 256, INP_MinAllowed = 0, INP_MaxAllowed = 256, INP_Integer = false, },
            CurrentOpacity = { LINKS_Name = "Internal current character opacity", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            MaskWidth = { LINKS_Name = "Internal mask width", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 2, INP_MinAllowed = 0, INP_MaxAllowed = 2, INP_Integer = false, },
            MaskCenterX = { LINKS_Name = "Internal mask center", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = -1, INP_MaxScale = 2, INP_MinAllowed = -1, INP_MaxAllowed = 2, INP_Integer = false, },
            MaskSoft = { LINKS_Name = "Internal mask softness", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            CurrentMaskWidth = { LINKS_Name = "Internal current mask width", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 2, INP_MinAllowed = 0, INP_MaxAllowed = 2, INP_Integer = false, },
            CurrentMaskCenterX = { LINKS_Name = "Internal current mask center", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = -1, INP_MaxScale = 2, INP_MinAllowed = -1, INP_MaxAllowed = 2, INP_Integer = false, },
            CurrentMaskSoft = { LINKS_Name = "Internal current mask softness", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_Integer = false, },
            ResetMotion = { LINKS_Name = "Reset motion", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "ButtonControl", BTNCS_Execute = "tool:SetInput(\"Softness\", 0.72); tool:SetInput(\"FadeWidth\", 0.035); tool:SetInput(\"GlowGain\", 0.16); tool:SetInput(\"GlowSize\", 1.1)", },
            ResetLook = { LINKS_Name = "Reset appearance", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_External = true, INPID_InputControl = "ButtonControl", BTNCS_Execute = "tool:SetInput(\"IdleOpacity\", 0.28); tool:SetInput(\"ActiveOpacity\", 1); tool:SetInput(\"IdleBrightness\", 0.52); tool:SetInput(\"IdleBlur\", 0.18); tool:SetInput(\"ActiveBlur\", 0); tool:SetInput(\"OverallOpacity\", 1); tool:SetInput(\"Size\", 0.075); tool:SetInput(\"CharacterSpacing\", 1); tool:SetInput(\"LineSpacing\", 1); tool:SetInput(\"Red1\", 0.97); tool:SetInput(\"Green1\", 0.98); tool:SetInput(\"Blue1\", 1)", },
          },
