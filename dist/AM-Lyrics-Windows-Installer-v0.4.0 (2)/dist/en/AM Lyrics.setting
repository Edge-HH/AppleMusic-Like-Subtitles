{
  Tools = ordered() {
    AMLLyrics = MacroOperator {
      Inputs = ordered() {
        Lyrics = InstanceInput { SourceOp = "Controller", Source = "Lyrics", Name = "Lyrics (separate words with |)", Page = "Controls", },
        SegmentCharacters = InstanceInput { SourceOp = "Controller", Source = "SegmentCharacters", Name = "Character marker (drag to choose)", Page = "Controls", },
        StartPosition = InstanceInput { SourceOp = "Controller", Source = "StartPosition", Name = "Start position", Page = "Controls", },
        EndPosition = InstanceInput { SourceOp = "Controller", Source = "EndPosition", Name = "End position", Page = "Controls", },
        SetSegment = InstanceInput { SourceOp = "Controller", Source = "SetSegment", Name = "Set segment", Page = "Controls", },
        SegmentStatus = InstanceInput { SourceOp = "Controller", Source = "SegmentStatus", Name = "Segment marker status", Page = "Controls", },
        Timings = InstanceInput { SourceOp = "Controller", Source = "Timings", Name = "Advanced: word timings (optional)", Page = "Controls", },
        Duration = InstanceInput { SourceOp = "Controller", Source = "Duration", Name = "Auto duration (seconds)", Page = "Controls", },
        Offset = InstanceInput { SourceOp = "Controller", Source = "Offset", Name = "Global delay (seconds)", Page = "Controls", },
        Softness = InstanceInput { SourceOp = "Controller", Source = "Softness", Name = "Highlight transition softness", Page = "Controls", },
        FPS = InstanceInput { SourceOp = "Controller", Source = "FPS", Name = "FPS (0 uses composition rate)", Page = "Controls", },
        FadeWidth = InstanceInput { SourceOp = "Controller", Source = "FadeWidth", Name = "In-word gradient width", Page = "Controls", },
        Status = InstanceInput { SourceOp = "Controller", Source = "Status", Name = "Input status", Page = "Controls", },
        ResetMotion = InstanceInput { SourceOp = "Controller", Source = "ResetMotion", Name = "Input status", Page = "Controls", },
        Font = InstanceInput { SourceOp = "Controller", Source = "Font", Name = "Font", Page = "Style", ControlGroup = 1, },
        Style = InstanceInput { SourceOp = "Controller", Source = "Style", Name = "Weight", Page = "Style", ControlGroup = 1, },
        Size = InstanceInput { SourceOp = "Controller", Source = "Size", Name = "Size", Page = "Style", },
        Center = InstanceInput { SourceOp = "Controller", Source = "Center", Name = "Position", Page = "Style", },
        CharacterSpacing = InstanceInput { SourceOp = "Controller", Source = "CharacterSpacing", Name = "Tracking", Page = "Style", },
        LineSpacing = InstanceInput { SourceOp = "Controller", Source = "LineSpacing", Name = "Line spacing", Page = "Style", },
        Red1 = InstanceInput { SourceOp = "Controller", Source = "Red1", Name = "Highlight color", Page = "Style", ControlGroup = 2, },
        Green1 = InstanceInput { SourceOp = "Controller", Source = "Green1", Name = "Highlight color", Page = "Style", ControlGroup = 2, },
        Blue1 = InstanceInput { SourceOp = "Controller", Source = "Blue1", Name = "Highlight color", Page = "Style", ControlGroup = 2, },
        IdleOpacity = InstanceInput { SourceOp = "Controller", Source = "IdleOpacity", Name = "Unplayed opacity", Page = "Style", },
        ActiveOpacity = InstanceInput { SourceOp = "Controller", Source = "ActiveOpacity", Name = "Played opacity", Page = "Style", },
        IdleBrightness = InstanceInput { SourceOp = "Controller", Source = "IdleBrightness", Name = "Unplayed brightness", Page = "Style", },
        IdleBlur = InstanceInput { SourceOp = "Controller", Source = "IdleBlur", Name = "Unplayed blur", Page = "Style", },
        ActiveBlur = InstanceInput { SourceOp = "Controller", Source = "ActiveBlur", Name = "Played blur", Page = "Style", },
        GlowGain = InstanceInput { SourceOp = "Controller", Source = "GlowGain", Name = "Current character glow gain", Page = "Style", },
        GlowSize = InstanceInput { SourceOp = "Controller", Source = "GlowSize", Name = "Current character glow size", Page = "Style", },
        OverallOpacity = InstanceInput { SourceOp = "Controller", Source = "OverallOpacity", Name = "Overall opacity", Page = "Style", },
        ResetLook = InstanceInput { SourceOp = "Controller", Source = "ResetLook", Name = "Reset appearance", Page = "Style", }
      },
      Outputs = { MainOutput1 = InstanceOutput { SourceOp = "FinalMerge", Source = "Output", } },
      ViewInfo = GroupInfo { Pos = { 0, 0 } },
      Tools = ordered() {
        Controller = TextPlus {
          Inputs = {
            Lyrics = Input { Value = "我|想要|留住|这一刻", },
            SegmentCharacters = Input { Value = 0, },
            Timings = Input { Value = "", },
            Duration = Input { Value = 4, },
            Offset = Input { Value = 0, },
            Softness = Input { Value = 0.72, },
            FPS = Input { Value = 0, },
            FadeWidth = Input { Value = 0.035, },
            IdleOpacity = Input { Value = 0.28, },
            ActiveOpacity = Input { Value = 1, },
            IdleBrightness = Input { Value = 0.52, },
            IdleBlur = Input { Value = 0.18, },
            ActiveBlur = Input { Value = 0, },
            GlowGain = Input { Value = 0.16, },
            GlowSize = Input { Value = 1.1, },
            OverallOpacity = Input { Value = 1, },
            SegmentStart = Input { Value = 0, },
            SegmentEnd = Input { Value = 0, },
            SegmentStatus = Input { Expression = ":local MAX_CHARACTERS = 256\n-- Embedded into Fusion expressions by tools/build.py. Lua 5.1 compatible.\n-- No filesystem, scripts, plugins or network calls at playback time.\nlocal function textValue(value)\n    if type(value) == \"string\" then return value end\n    return value and value.Value or \"\"\nend\nlocal function numberValue(value, fallback)\n    local raw = value\n    if type(raw) == \"table\" then raw = raw.Value end\n    local result = tonumber(raw)\n    return result or fallback\nend\nlocal function characters(value)\n    local result = {}\n    for character in value:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do result[#result + 1] = character end\n    return result\nend\nlocal function split(value)\n    local result = {}\n    for part in (value .. \"|\"):gmatch(\"(.-)|\") do result[#result + 1] = part end\n    return result\nend\nlocal function clamp(value, low, high) return math.max(low, math.min(high, value)) end\nlocal raw = textValue(Controller.Lyrics):gsub(\"\\r\\n\", \"\\n\"):gsub(\"\\r\", \"\\n\")\nlocal segments = split(raw)\nlocal clean = table.concat(segments, \"\")\nlocal count = #characters(clean)\nlocal fps = tonumber(Controller.FPS) or 0\nif fps <= 0 then fps = tonumber(comp:GetPrefs(\"Comp.FrameFormat.Rate\")) or 24 end\nfps = math.max(fps, 1)\nlocal now = (time - comp.RenderStart) / fps - Controller.Offset\nlocal ranges, errorMessage = {}, nil\nlocal schedule = textValue(Controller.Timings)\nlocal manual = schedule:match(\"%S\") ~= nil\nlocal span = math.max(tonumber(Controller.Duration) or 4, 1 / fps)\nlocal cursor = 0\nfor _, segment in ipairs(segments) do\n    local length = #characters(segment)\n    if length == 0 then errorMessage = \"Empty segment: remove adjacent or edge |\" end\n    ranges[#ranges + 1] = {first = cursor + 1, length = length,\n        start = span * cursor / math.max(count, 1),\n        finish = span * (cursor + length) / math.max(count, 1)}\n    cursor = cursor + length\nend\nif manual then\n    local entries = split(schedule)\n    if #entries ~= #segments then errorMessage = \"Timing count must match lyric segments\"\n    else\n        local previousEnd = 0\n        for index, entry in ipairs(entries) do\n            local a, b = entry:match(\"^%s*(%d+%.?%d*)%s*%-%s*(%d+%.?%d*)%s*$\")\n            a, b = tonumber(a), tonumber(b)\n            if not a or not b or b <= a or a < previousEnd then\n                errorMessage = \"Use ascending non-overlapping start-end seconds\"\n                break\n            end\n            ranges[index].start, ranges[index].finish = a, b\n            previousEnd = b\n        end\n    end\nend\nif count > MAX_CHARACTERS then errorMessage = \"Over \" .. MAX_CHARACTERS .. \" characters: split the lyric line\" end\nif count == 0 then errorMessage = \"Enter lyrics\" end\nlocal valid = errorMessage == nil\nlocal status = errorMessage and (\"STATIC FALLBACK: \" .. errorMessage) or\n    ((manual and \"Custom timing\" or \"Auto timing\") .. \" | \" .. count .. \" characters\")\nlocal segmentCharacters = math.max(0, math.floor(numberValue(Controller.SegmentCharacters, 0) + 0.5))\nlocal segmentStart = math.max(0, math.floor(numberValue(Controller.SegmentStart, 0) + 0.5))\nlocal segmentEnd = math.max(0, math.floor(numberValue(Controller.SegmentEnd, 0) + 0.5))\nlocal segmentStatus = string.format(\"Character marker: %d / %d | start: %d | end: %d\", segmentCharacters, count, segmentStart, segmentEnd)\nlocal function smooth(value)\n    local p = clamp(value, 0, 1)\n    return p * p * (3 - 2 * p)\nend\nlocal function progress(index)\n    if not valid or index > count then return -1 end\n    for _, range in ipairs(ranges) do\n        if index >= range.first and index < range.first + range.length then\n            local step = (range.finish - range.start) / range.length\n            local start = range.start + (index - range.first) * step\n            local duration = math.max(step * math.max(0.01, Controller.Softness), 0.000001)\n            return smooth((now - start) / duration)\n        end\n    end\n    return -1\nend\nlocal sweep = valid and 0 or 1\nlocal currentIndex = 0\nif valid then\n    local completed = 0\n    for _, range in ipairs(ranges) do\n        local rangeDuration = math.max(range.finish - range.start, 0.000001)\n        local localProgress = smooth((now - range.start) / rangeDuration)\n        if now >= range.finish then\n            completed = completed + range.length\n        elseif now >= range.start then\n            sweep = (completed + range.length * localProgress) / math.max(count, 1)\n            local step = rangeDuration / math.max(range.length, 1)\n            local offset = math.floor(math.max(0, now - range.start) / math.max(step, 0.000001))\n            offset = math.min(math.max(offset, 0), math.max(range.length - 1, 0))\n            currentIndex = range.first + offset\n            break\n        else\n            sweep = completed / math.max(count, 1)\n            break\n        end\n        sweep = completed / math.max(count, 1)\n    end\nend\nsweep = clamp(sweep, 0, 1)\nlocal spacing = math.max(0.2, tonumber(Controller.CharacterSpacing) or 1)\nlocal textWidth = clamp(count * (tonumber(Controller.Size) or 0.075) * 0.55 * spacing, 0.03, 0.92)\nlocal fadeWidth = clamp(tonumber(Controller.FadeWidth) or 0.035, 0.001, 0.25)\nlocal maskWidth = clamp(textWidth * sweep + fadeWidth, fadeWidth, textWidth + fadeWidth)\nlocal centerX = tonumber(Controller.Center.X) or 0.5\nlocal maskCenterX = centerX - textWidth / 2 + maskWidth / 2\n-- Keep the leading edge visible but make the active/inactive boundary readable.\nlocal maskSoft = clamp(fadeWidth / math.max(maskWidth, 0.001), 0.002, 0.18)\nlocal currentMaskWidth = 0\nlocal currentMaskCenterX = centerX\nlocal currentMaskSoft = 0.01\nif currentIndex > 0 and currentIndex <= count then\n    local characterWidth = textWidth / math.max(count, 1)\n    currentMaskWidth = clamp(characterWidth + fadeWidth * 0.5, fadeWidth, 1)\n    currentMaskCenterX = centerX - textWidth / 2 + characterWidth * (currentIndex - 0.5)\n    currentMaskSoft = clamp((fadeWidth / math.max(characterWidth, 0.001)) * 0.08, 0.01, 0.08)\nend\nlocal currentOpacity = (currentIndex > 0 and currentIndex <= count) and 1 or 0\n\nreturn segmentStatus", },
