dth + fadeWidth * 0.5, fadeWidth, 1)\n    currentMaskCenterX = centerX - textWidth / 2 + characterWidth * (currentIndex - 0.5)\n    currentMaskSoft = clamp((fadeWidth / math.max(characterWidth, 0.001)) * 0.08, 0.01, 0.08)\nend\nlocal currentOpacity = (currentIndex > 0 and currentIndex <= count) and 1 or 0\n\nreturn clean", },
